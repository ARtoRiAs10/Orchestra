# URL of the Orchestra master's HTTP API (registration + heartbeats)
MASTER_URL=http://localhost:4000

# Redis connection string - must match the master's REDIS_URL (shared job queue)
REDIS_URL=redis://localhost:6379

# How many jobs this worker will process concurrently
CONCURRENCY=2

# BullMQ lock duration for a running job. The worker extends this lock while a
# step executes, so it only needs to be long enough to cover the gap between
# extensions. If a worker dies, its job is retried after this interval.
JOB_LOCK_DURATION_MS=300000

# How often (ms) to send a heartbeat to the master
HEARTBEAT_INTERVAL_MS=5000

# Human-readable identifier for this worker, shown on the dashboard.
# Defaults to the OS hostname if unset.
WORKER_HOSTNAME=

# Directory containing SSH private keys referenced by pipeline steps
# (mounted read-only, e.g. ./keys:/keys in docker-compose)
SSH_KEY_DIR=/keys
