{
  "name": "orchestra-worker",
  "version": "1.0.0",
  "description": "Orchestra worker agent: pulls jobs from the queue, executes shell/SSH steps, streams logs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bullmq": "^5.7.8",
    "dotenv": "^16.4.5",
    "ioredis": "5.10.1",
    "socket.io-client": "^4.7.5",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/ssh2": "^1.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
