# Used by `docker compose up` to fill in ${VAR} references in docker-compose.yml.
# Copy to `.env` in this same directory (docker compose loads .env automatically)
# and fill in real values. For local `npm run dev` workflows, use the
# per-service .env files instead (master/.env, worker/.env, frontend/.env.local).

# --- Clerk (shared between master + frontend - same Clerk application) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend public URLs (must be reachable from the user's browser) ---
NEXT_PUBLIC_ORCHESTRA_API_URL=http://localhost:4000
NEXT_PUBLIC_ORCHESTRA_SOCKET_URL=http://localhost:4000

# Set true only for local dev without Clerk configured. Never use in production.
AUTH_OPTIONAL=false
