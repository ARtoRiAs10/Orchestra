# Used by `docker compose up` to fill in ${VAR} references in docker-compose.yml.
# Copy to `.env` in this same directory (docker compose loads .env automatically)
# and fill in real values. For local `npm run dev` workflows, use the
# per-service .env files instead (master/.env, worker/.env, frontend/.env.local).

# --- Clerk (shared between master + frontend - same Clerk application) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend public URLs (must be reachable from the user's browser) ---
# These are baked into the frontend at BUILD time (Next.js NEXT_PUBLIC_*),
# so changing them requires `docker compose up --build` (or restarting
# `npm run dev`), not just an env change.
#
# Plain local dev (`docker compose up` on your own machine): leave as-is.
#
# GitHub Codespaces: "localhost" in these two vars means "the browser's own
# machine", not the codespace container — so with the default below, pipeline
# creation / run-triggering / log streaming will silently fail even though
# the health check and server-rendered pages work. Set these to the
# forwarded URL for port 4000 instead, e.g.:
#   NEXT_PUBLIC_ORCHESTRA_API_URL=https://$CODESPACE_NAME-4000.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN
#   NEXT_PUBLIC_ORCHESTRA_SOCKET_URL=https://$CODESPACE_NAME-4000.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN
# (run `echo $CODESPACE_NAME` / `echo $GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN`
# in the codespace terminal to see the literal values), and make sure port
# 4000 is forwarded with visibility set to "Public" (or at least accessible
# to you) in the Ports tab — Private ports return 401s to the browser.
NEXT_PUBLIC_ORCHESTRA_API_URL=http://localhost:4000
NEXT_PUBLIC_ORCHESTRA_SOCKET_URL=http://localhost:4000

# The frontend origin the browser actually loads pages from. The master API
# uses this to tell Clerk which origin is allowed to have issued a session
# token (`authorizedParties`) — a mismatch here is the other common cause of
# "pipeline creation fails with a 401" in Codespaces. In Codespaces this
# is auto-detected from CODESPACE_NAME / GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN
# (see master/src/config.ts), so you usually don't need to set this manually.
# Only set it if you're on a custom domain / tunnel outside Codespaces.
# FRONTEND_URL=https://your-custom-domain.example.com

# Set true only for local dev without Clerk configured. Never use in production.
AUTH_OPTIONAL=false
