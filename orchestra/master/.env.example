PORT=4000

# Postgres connection string
DATABASE_URL=postgres://orchestra:orchestra@localhost:5432/orchestra

# Redis connection string (used by BullMQ for the job queue)
REDIS_URL=redis://localhost:6379

# Worker is considered "dead" if no heartbeat received within this many ms
HEARTBEAT_TIMEOUT_MS=15000

# How often (ms) the heartbeat monitor sweeps for dead workers
HEARTBEAT_SWEEP_INTERVAL_MS=5000

# Allowed origin for the dashboard (CORS + socket.io)
DASHBOARD_ORIGIN=*

# --- Clerk (auth) ---
# Get from https://dashboard.clerk.com -> your app -> API Keys.
# Must match the frontend's Clerk app (same instance).
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Set to "true" only for local development without Clerk configured -
# requests with no token are treated as a fixed dev user. Never use in prod.
AUTH_OPTIONAL=false

# --- Razorpay (billing webhook) ---
# Used only to verify the X-Razorpay-Signature header on incoming webhooks.
# Get from https://dashboard.razorpay.com -> Settings -> API Keys / Webhooks.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Rate limiting ---
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
