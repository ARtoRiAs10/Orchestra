# --- Clerk (auth) ---
# Get these from https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/pipelines
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/pipelines

# --- Orchestra master API ---
# Server-side (Server Components, Route Handlers) base URL
ORCHESTRA_API_URL=http://localhost:4000
# Client-side (browser) base URL - must be reachable from the user's browser
NEXT_PUBLIC_ORCHESTRA_API_URL=http://localhost:4000
NEXT_PUBLIC_ORCHESTRA_SOCKET_URL=http://localhost:4000

# --- Razorpay (billing) ---
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
